{
  "manifest_version": 3,
  "name": "PastePhoto",
  "version": "0.4.1",
  "description": "Pastes your screenshots into Claude (claude.ai). Companion of the PastePhoto desktop app.",
  "key": "",
  "permissions": ["nativeMessaging", "tabs", "scripting", "alarms"],
  "host_permissions": ["https://claude.ai/*"],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["https://claude.ai/*"],
      "js": ["cursor.js"],
      "run_at": "document_start"
    }
  ],
  "icons": {
    "128": "icon128.png"
  }
}
